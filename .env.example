FLASK_SECRET_KEY=replace-with-a-long-random-secret
DEFAULT_BRANCH=main
# SQLite database path. Relative paths are resolved from the app working directory.
QUEUE_DB_PATH=instance/psa_queue.db
# Optional one-time seed if the users table is empty.
# Format: branch:username:password;branch2:username2:password2
QUEUE_ADMIN_USERS=
# Optional legacy API token. Leave blank when using staff login only.
QUEUE_ADMIN_TOKEN=
TRUST_PROXY=true
GUNICORN_BIND=0.0.0.0:8000
